+class MiniMaxH3LatentUpscaleBy:
+    """Upscale an H3 AV Latent (or standard video/image latent) in latent space.
+
+    Correctly unpacks nested (video, audio) streams, upscales the 5D video latent
+    spatially using bicubic / bislerp while preserving frame count and audio track,
+    and repacks into a decodable NestedTensor for VAE decode or high-res diffusion refine.
+    """
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {
+            "required": {
+                "samples": ("LATENT", {"tooltip": "The H3 AV latent to upscale."}),
+                "upscale_method": (["bicubic", "bilinear", "nearest-exact", "area"], {"default": "bicubic"}),
+                "scale_by": ("FLOAT", {"default": 1.5, "min": 0.01, "max": 8.0, "step": 0.05}),
+            }
+        }
+
+    RETURN_TYPES = ("LATENT",)
+    FUNCTION = "upscale"
+    CATEGORY = "video/MinimaxH3"
+
+    def upscale(self, samples, upscale_method, scale_by):
+        s = samples["samples"]
+        video = None
+        audio = None
+
+        if isinstance(s, (list, tuple)):
+            video = s[0]
+            audio = s[1] if len(s) > 1 else None
+        elif hasattr(s, "is_nested") and s.is_nested:
+            parts = s.unbind()
+            video = parts[0]
+            audio = parts[1] if len(parts) > 1 else None
+        elif hasattr(s, "unbind"):
+            try:
+                parts = s.unbind()
+                video = parts[0]
+                audio = parts[1] if len(parts) > 1 else None
+            except Exception:
+                video = s
+                audio = None
+        else:
+            video = s
+
+        orig_shape = video.shape
+        target_h = max(2, int(round(orig_shape[-2] * scale_by)))
+        target_w = max(2, int(round(orig_shape[-1] * scale_by)))
+        if target_h % 2 != 0:
+            target_h += 1
+        if target_w % 2 != 0:
+            target_w += 1
+
+        if len(orig_shape) == 5:
+            # (B, C, T, H, W) -> (B*T, C, H, W)
+            B, C, T, H, W = orig_shape
+            v_2d = video.permute(0, 2, 1, 3, 4).reshape(B * T, C, H, W)
+            v_up = comfy.utils.bislerp(v_2d, target_w, target_h)
+            video_up = v_up.reshape(B, T, C, target_h, target_w).permute(0, 2, 1, 3, 4)
+        elif len(orig_shape) == 4:
+            video_up = comfy.utils.bislerp(video, target_w, target_h)
+        else:
+            video_up = video
+
+        out = samples.copy()
+        if audio is not None:
+            try:
+                out["samples"] = comfy.nested_tensor.NestedTensor((video_up, audio))
+            except Exception:
+                out["samples"] = torch.nested.nested_tensor([video_up, audio])
+        else:
+            out["samples"] = video_up
+
+        return (out,)
+
+
