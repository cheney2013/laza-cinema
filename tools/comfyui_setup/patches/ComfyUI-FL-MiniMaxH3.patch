+    # The audio VAE's frame count is rounded differently from the video grid, so
+    # the encoded source can come out one or two audio frames short or long of the
+    # latent the render expects (seen 291 vs 292). Pad with the last frame or trim
+    # rather than failing the job; a larger mismatch is still an error.
+    # (local patch 2026-09-22)
+    if (encoded.shape != expected.shape and encoded.ndim == expected.ndim
+            and encoded.shape[:-1] == expected.shape[:-1]
+            and abs(encoded.shape[-1] - expected.shape[-1]) <= 2):
+        want = expected.shape[-1]
+        if encoded.shape[-1] < want:
+            tail = encoded[..., -1:].expand(*encoded.shape[:-1], want - encoded.shape[-1])
+            encoded = torch.cat((encoded, tail), dim=-1)
+        else:
+            encoded = encoded[..., :want]
