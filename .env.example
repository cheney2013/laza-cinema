# ==============================================================================
# LAZA CINEMA STUDIO — Central Configuration
# ==============================================================================

# ComfyUI port template. Browser-side URLs use the address-bar hostname/IP.
COMFYUI_URL=http://localhost:8188

# Backend FastAPI Server
BACKEND_PORT=8003
# The frontend replaces localhost with the browser address-bar hostname/IP.
BACKEND_URL=http://localhost:8003

# Frontend Next.js Server
FRONTEND_PORT=4000

# Where ComfyUI keeps its files. The backend reads clips, point clouds and latents straight
# from these folders, so they are required on any machine that is not the original author's.
COMFYUI_OUTPUT_DIR=
COMFYUI_INPUT_DIR=

# Optional OpenAI-compatible LLM (LM Studio, Ollama, vLLM...) for prompt translation and
# optimisation only. Leave LLM_BASE_URL empty to run without it: those two helpers stay off.
LLM_BASE_URL=
LLM_MODEL=qwen2.5-vl-3b-instruct
LLM_API_KEY=local

# H3 machine profile (backend/machine_profile.py), read by start.ps1:
#   workstation -- RTX 5090 32GB: Singularity int8, 1376x768
#   lowvram     -- 16GB card (e.g. 5060 Ti): pruned ref2va NVFP4 + turbo LoRA, 864x480, tiled VAE decode
# Also set it in the ai-cinema-canvas MCP server's env so its defaults match.
H3_MACHINE_PROFILE=auto

# The H3 text encoder file. Leave empty for the NVFP4 build (works on any NVIDIA card per Comfy-Org).
# "int4" selects the INT4 convrot build, or give a file name.
H3_TEXT_ENCODER=

# The latent upscaler checkpoint behind the H3 latent video enhance (a file in
# ComfyUI/models/latent_upscale_models/). Empty = minimax_h3_latent_upscaler_3d_bf16.safetensors.
# The v1 conv build is minimax_h3_latent_upscaler_3d_conv_v1_bf16.safetensors.
H3_LATENT_UPSCALER=

# Qwen-Image 2.1 on a small card (optional). Leave empty to use the INT8 files that ship with
# the standard setup. A community GGUF goes in ComfyUI/models/unet/ and needs the ComfyUI-GGUF
# custom node; a lighter Qwen3-VL 8B text encoder goes in models/text_encoders/.
# See docs/DEPLOY.md, section "16 GB 显存机器".
QWEN_IMAGE_UNET=
QWEN_IMAGE_CLIP=

# Canvas MCP (port 8004), used by AI agents such as Claude Code. Generate a token once:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# then put the SAME value here and in the user environment of the shell that runs the agent
# (docs/DEPLOY.md, section "MCP token"). Empty means no authentication: only do that on a
# machine nobody else can reach.
AI_CINEMA_MCP_TOKEN=

# Optional NVIDIA NIM fallback key
NV_API_KEY=your_nvidia_api_key_here
