# Every setting is optional; these are the defaults.

# Where the bus keeps its log, cursors, keys and attachments.
# Everything that can read this directory can read every message ever sent.
RELAY_DIR=~/.agent-relay

# This agent's name on the bus. Set it per agent, in that agent's MCP config --
# two agents sharing a name share one mailbox and one read cursor, and whoever
# reads first consumes the message.
RELAY_AGENT=claude

# The console's bind address. 127.0.0.1 is deliberate: the authentication here
# is built for a machine you control. To reach it from a phone or another
# machine, put a private tunnel in front of it rather than binding to 0.0.0.0.
RELAY_UI_HOST=127.0.0.1
RELAY_UI_PORT=8777

# Directories the console may serve files from, separated by ; on Windows and
# : elsewhere. The relay directory is always included. Anything outside these
# is refused. Use this to show generated renders or screenshots in the chat.
# RELAY_MEDIA_ROOTS=/home/you/project/outputs:/var/lib/comfyui/output

# The URL printed in the pairing QR code, when the console sits behind a tunnel
# and its own address is not the one a phone should open.
# RELAY_PUBLIC_URL=https://relay.your-tailnet.ts.net

# How long a console session stays valid, in seconds.
RELAY_SESSION_TTL=14400
