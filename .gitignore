# >>> content
# Film content (prompts, previs scenes, sets, plates, reference audio, scene
# models) is not platform code. It stays on disk and is recorded in
# backend/workspaces/content_archive.db by tools/content_archive.py
# (text files by content, media files by path only).
/backend/previs/*
!/backend/previs/rig.py
!/backend/previs/figures.py
!/backend/previs/make_sheet.py
!/backend/previs/render_textured_camera.py
!/backend/previs/render_plate_camera.py
!/backend/previs/render_camera_move.py
!/backend/previs/plate_coverage.py
!/backend/previs/scene_config.py
!/backend/previs/vendor/
/models/
